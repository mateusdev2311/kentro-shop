generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusLoja {
  pendente_integracao
  ativa
  bloqueada
}

model Loja {
  id                   String     @id @default(uuid()) @db.Uuid
  nome                 String?
  chaveAdminHash       String     @unique @map("chave_admin_hash")
  chaveAtendimentoHash String     @unique @map("chave_atendimento_hash")
  tokenMcpHash         String     @unique @map("token_mcp_hash")
  status               StatusLoja @default(pendente_integracao)
  plano                String     @default("gratis")
  limites              Json       @default("{}")
  criadoEm             DateTime   @default(now()) @map("criado_em")
  atualizadoEm         DateTime   @updatedAt @map("atualizado_em")

  integracao Integracao?
  chamadas   ChamadaConector[]
  regras     RegraProduto[]
  config     ConfigLoja?
  sessoes    Sessao[]
  clientes   ClienteLoja[]
  catalogoKentro CatalogoKentro?
  produtosKentro ProdutoKentro[]

  @@map("lojas")
}

/// Cópia do catálogo da Kentro enviada pela extensão (omni.products.list). Uma sincronização por vez.
model CatalogoKentro {
  lojaId          String    @id @map("loja_id") @db.Uuid
  /// Grupos com produto na última sincronização: [{ id, nome }] (vazio se a Kentro não deu os nomes).
  grupos          Json      @default("[]")
  total           Int       @default(0)
  sincronizadoEm  DateTime? @map("sincronizado_em")
  /// Sincronização em andamento (trava): o lote e a última parte recebida.
  loteAtual       String?   @map("lote_atual")
  loteAtividadeEm DateTime? @map("lote_atividade_em")

  loja Loja @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@map("catalogos_kentro")
}

/// Produto do catálogo da Kentro, já no formato do contrato (dados). busca = nome e SKU sem acento, em minúsculas.
model ProdutoKentro {
  lojaId String   @map("loja_id") @db.Uuid
  id     String
  nome   String
  sku    String
  busca  String
  grupos String[] @default([])
  dados  Json
  lote   String

  loja Loja @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@id([lojaId, id])
  @@index([lojaId, sku])
  @@index([lojaId, nome])
  @@map("produtos_kentro")
}

enum StatusIntegracao {
  pendente
  ok
  erro
}

/// Conexão da loja com a plataforma de e-commerce. Credenciais só cifradas (AES-256-GCM).
model Integracao {
  lojaId              String           @id @map("loja_id") @db.Uuid
  plataforma          String
  credenciaisCifradas Bytes            @map("credenciais_cifradas")
  iv                  Bytes
  status              StatusIntegracao @default(pendente)
  ultimoTesteEm       DateTime?        @map("ultimo_teste_em")
  ultimoErro          String?          @map("ultimo_erro")
  /// Id da loja na plataforma (ex.: store_id da Nuvemshop), para achar a integração pelos webhooks dela.
  idExterno           String?          @map("id_externo")
  criadoEm            DateTime         @default(now()) @map("criado_em")
  atualizadoEm        DateTime         @updatedAt @map("atualizado_em")

  loja Loja @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@index([plataforma, idExterno])
  @@map("integracoes")
}

/// Registro de cada chamada feita a uma plataforma (aba Saúde). Sem URL, query nem credencial.
model ChamadaConector {
  id         BigInt   @id @default(autoincrement())
  lojaId     String   @map("loja_id") @db.Uuid
  plataforma String
  operacao   String
  statusHttp Int?     @map("status_http")
  ms         Int
  erroCodigo String?  @map("erro_codigo")
  em         DateTime @default(now())

  loja Loja @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@index([lojaId, em])
  @@map("chamadas_conector")
}

/// Dados que a loja cadastra por SKU e que a plataforma não tem (spec 7.4).
model RegraProduto {
  lojaId       String   @map("loja_id") @db.Uuid
  sku          String
  oculto       Boolean  @default(false)
  selo         String?
  m2PorUnidade Float?   @map("m2_por_unidade")
  rendimentoM2 Float?   @map("rendimento_m2")
  compreJunto  String[] @default([]) @map("compre_junto")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  loja Loja @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@id([lojaId, sku])
  @@map("regras_produto")
}

/// Configuração da loja (tema, entrega, frete, retirada). Campos ausentes usam os padrões do ConfigLojaService.
model ConfigLoja {
  lojaId            String   @id @map("loja_id") @db.Uuid
  tema              Json     @default("{}")
  entrega           Json     @default("{}")
  retirada          Json     @default("{}")
  frete             Json     @default("{}")
  lojasRetirada     Json     @default("[]") @map("lojas_retirada")
  modoPedido        String   @default("handoff") @map("modo_pedido")
  expiracaoLinkDias Int      @default(7) @map("expiracao_link_dias")
  categoriasOcultas String[] @default([]) @map("categorias_ocultas")
  urlCapturaKentro  String?  @map("url_captura_kentro")
  /// Padrão da loja; cada link pode mudar (Sessao.mostrarPrecos).
  mostrarPrecos     Boolean  @default(true) @map("mostrar_precos")
  /// Logo enviado pelo admin (PNG/JPG/WebP até 300 KB), servido com cache longo pelo hash.
  logo              Bytes?
  logoTipo          String?  @map("logo_tipo")
  logoHash          String?  @map("logo_hash")
  atualizadoEm      DateTime @updatedAt @map("atualizado_em")

  loja Loja @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@map("configuracoes_loja")
}

enum StatusSessao {
  link_enviado
  navegando
  finalizado
  pedido_criado
  expirado
}

/// Carrinho de um atendimento, acessado pelo cliente via link com token.
model Sessao {
  id           String       @id @default(uuid()) @db.Uuid
  lojaId       String       @map("loja_id") @db.Uuid
  token        String       @unique
  chatId       String       @map("chat_id")
  cliente      Json
  status       StatusSessao @default(link_enviado)
  checkout     Json?
  totais       Json
  desconto     Json?
  abertaEm     DateTime?    @map("aberta_em")
  finalizadaEm DateTime?    @map("finalizada_em")
  expiraEm     DateTime     @map("expira_em")
  /// Link com filtro (categoria, busca ou produtos escolhidos). null = catálogo todo.
  filtro        Json?
  /// Com filtro: true = o cliente vê só o filtro; false = pode abrir o catálogo todo.
  restrito      Boolean      @default(true)
  /// null = segue a loja.
  mostrarPrecos Boolean?     @map("mostrar_precos")
  /// Pedido criado na plataforma ao finalizar (modo criar_pedido): { idExterno, numero, url, status }.
  pedido        Json?
  criadaEm     DateTime     @default(now()) @map("criada_em")
  atualizadaEm DateTime     @updatedAt @map("atualizada_em")

  loja    Loja           @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  itens   ItemCarrinho[]
  eventos EventoSessao[]

  @@index([lojaId, chatId])
  @@map("sessoes")
}

/// Item do carrinho: o item vendável (produto simples ou variação) com o preço revalidado no servidor.
model ItemCarrinho {
  id            String   @id @default(uuid()) @db.Uuid
  sessaoId      String   @map("sessao_id") @db.Uuid
  produtoId     String   @map("produto_id")
  variacaoId    String   @default("") @map("variacao_id")
  sku           String
  nome          String
  variacaoNome  String?  @map("variacao_nome")
  imagem        String?
  unidade       String
  precoUnitario Decimal  @map("preco_unitario") @db.Decimal(12, 2)
  quantidade    Int
  m2            Float?
  revalidadoEm  DateTime @default(now()) @map("revalidado_em")

  sessao Sessao @relation(fields: [sessaoId], references: [id], onDelete: Cascade)

  @@unique([sessaoId, produtoId, variacaoId])
  @@map("itens_carrinho")
}

enum AutorEvento {
  cliente
  atendente
  sistema
  ia
}

/// Cliente da loja pelo telefone: endereços usados e últimos pedidos (para "pedir de novo").
model ClienteLoja {
  id           String   @id @default(uuid()) @db.Uuid
  lojaId       String   @map("loja_id") @db.Uuid
  /// Só dígitos, com DDI (ex.: 5538988887777).
  telefone     String
  nome         String   @default("")
  email        String?
  documento    String?
  /// Até 5, o mais recente primeiro.
  enderecos    Json     @default("[]")
  /// Até 5 pedidos finalizados, o mais recente primeiro (itens com produtoId/variacaoId para repetir).
  pedidos      Json     @default("[]")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  loja Loja @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@unique([lojaId, telefone])
  @@map("clientes_loja")
}

model EventoSessao {
  id       String      @id @default(uuid()) @db.Uuid
  sessaoId String      @map("sessao_id") @db.Uuid
  tipo     String
  texto    String
  autor    AutorEvento
  em       DateTime    @default(now())

  sessao Sessao @relation(fields: [sessaoId], references: [id], onDelete: Cascade)

  @@index([sessaoId, em])
  @@map("eventos_sessao")
}
